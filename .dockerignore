# 版本控制与本地开发环境
.git
.gitignore
.github
.codex
.idea
.vscode
.venv
.python-version

# Python 产物
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
.pytest_cache

# 运行期数据：账号凭证、日志、图片，绝不能进镜像
data
.env
.env.*

# 测试、文档、示例素材
test
docs
CHANGELOG.md
README.md
LICENSE
assets

# 本地编排文件（镜像内用不到）
docker-compose*.yml

# 前端：只保留构建所需的源码与锁文件
web/.next
web/node_modules
web/dist
web/tsconfig.tsbuildinfo
web/package-lock.json
